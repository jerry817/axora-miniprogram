.mine-page{
  padding:30rpx;
  padding-bottom:calc(60rpx + var(--tabbar-height));
}

.profile-card{
  display:flex;
  align-items:center;
  padding:36rpx;
  background:white;
  border-radius:30rpx;
  color:#0a0909;
  margin-bottom:24rpx;
  box-shadow:0 10rpx 30rpx rgba(0,0,0,.05);
}

.avatar{
  width:110rpx;
  height:110rpx;
  border-radius:50%;
  background:#eef2f8;
  flex-shrink:0;
  border:2rpx solid #f0f0f0;
}

.profile-info{
  margin-left:24rpx;
  flex:1;
  min-width:0;
}

.nickname{
  font-size:34rpx;
  font-weight:700;
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
}

.desc{
  margin-top:8rpx;
  font-size:26rpx;
  color:#0b0b0b;
  font-weight:500;
}

.login-tip{
  margin-top:8rpx;
  font-size:24rpx;
  color:#1677ff;
}

.login-btn{
  flex-shrink:0;
  padding:14rpx 28rpx;
  background:#1677ff;
  color:#fff;
  font-size:26rpx;
  font-weight:600;
  border-radius:99rpx;
  box-shadow:0 8rpx 20rpx rgba(22,119,255,.3);
}

.menu-list{
  background:#fff;
  border-radius:24rpx;
  overflow:hidden;
  box-shadow:0 10rpx 30rpx rgba(0,0,0,.05);
}

.menu-item{
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:28rpx 30rpx;
  font-size:28rpx;
  color:#333;
  border-bottom:1rpx solid #f5f5f5;
}

.menu-item:last-child{
  border-bottom:none;
}

.arrow{
  color:#ccc;
  font-size:32rpx;
}

.user-id{
  color:#1677ff;
  font-size:24rpx;
}

.menu-item--danger text:first-child{
  color:#ff4d4f;
}

.version-text{
  text-align:center;
  margin-top:40rpx;
  font-size:22rpx;
  color:#bbb;
}

/* ---- 通用弹窗（隐私协议 / 版本说明） ---- */
.modal-mask{
  position:fixed;
  top:0;
  left:0;
  right:0;
  bottom:0;
  background:rgba(0,0,0,.5);
  z-index:9998;
  display:flex;
  align-items:center;
  justify-content:center;
  padding:0 60rpx;
}

.modal-card{
  width:100%;
  max-height:75vh;
  background:#fff;
  border-radius:28rpx;
  padding:40rpx 36rpx 32rpx;
  display:flex;
  flex-direction:column;
  box-shadow:0 20rpx 60rpx rgba(0,0,0,.2);
}

.modal-title{
  font-size:34rpx;
  font-weight:700;
  text-align:center;
  margin-bottom:28rpx;
  flex-shrink:0;
}

.modal-body{
  max-height:60vh;
  margin-bottom:28rpx;
}

.modal-paragraph{
  font-size:26rpx;
  color:#555;
  line-height:1.7;
  margin-bottom:20rpx;
}

.modal-paragraph:last-child{
  margin-bottom:0;
}

.modal-actions{
  display:flex;
  gap:20rpx;
  flex-shrink:0;
}

.modal-btn{
  flex:1;
  text-align:center;
  padding:20rpx 0;
  border-radius:16rpx;
  font-size:28rpx;
  font-weight:600;
}

.modal-btn--ghost{
  background:#f5f6f8;
  color:#666;
}

.modal-btn--primary{
  background:#1677ff;
  color:#fff;
}

.modal-btn--full{
  flex:none;
  width:100%;
  flex-shrink:0;
}

.login-modal{
  align-items:stretch;
}

.login-modal-tip{
  margin:-10rpx 0 28rpx;
  color:#7b8794;
  font-size:24rpx;
  text-align:center;
}

.avatar-choice{
  display:flex;
  width:100%;
  align-items:center;
  justify-content:center;
  gap:18rpx;
  margin:0 0 22rpx;
  padding:16rpx;
  border:0;
  border-radius:18rpx;
  background:#f4f8ff;
  color:#1677ff;
  font-size:27rpx;
}

.avatar-choice::after{
  border:0;
}

.avatar-choice-image{
  width:70rpx;
  height:70rpx;
  border-radius:50%;
  background:#e8eef7;
}

.nickname-input{
  height:88rpx;
  margin-bottom:28rpx;
  padding:0 24rpx;
  border-radius:16rpx;
  background:#f5f7fa;
  font-size:28rpx;
}

.version-block{
  margin-bottom:24rpx;
}

.version-block:last-child{
  margin-bottom:0;
}

.version-heading{
  display:flex;
  align-items:center;
  gap:14rpx;
  font-size:30rpx;
  font-weight:700;
  color:#1f2937;
  margin-bottom:14rpx;
}

.version-tag{
  font-size:20rpx;
  font-weight:500;
  color:#1677ff;
  background:#e8f2ff;
  padding:2rpx 14rpx;
  border-radius:99rpx;
}

.version-line{
  font-size:26rpx;
  color:#555;
  line-height:1.7;
}

.easter-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.85);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
}
.easter-img {
  width: 82%;
}
