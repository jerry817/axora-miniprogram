.history-page{
  padding:24rpx 30rpx calc(60rpx + var(--tabbar-height));
  min-height:100vh;
  box-sizing:border-box;
}

.header-bar{
  display:flex;
  align-items:center;
  justify-content:space-between;
  margin-bottom:20rpx;
}

.count-text{
  font-size:24rpx;
  color:#999;
}

.clear-btn{
  font-size:26rpx;
  color:#ff4d4f;
}

.history-list{
  display:flex;
  flex-direction:column;
  gap:20rpx;
}

.history-item{
  display:flex;
  align-items:center;
  background:#fff;
  border-radius:20rpx;
  padding:24rpx;
  box-shadow:0 8rpx 24rpx rgba(0,0,0,.04);
}

.item-main{
  flex:1;
  min-width:0;
}

.item-top{
  display:flex;
  align-items:center;
  justify-content:space-between;
  margin-bottom:10rpx;
}

.item-tag{
  font-size:22rpx;
  padding:4rpx 14rpx;
  border-radius:99rpx;
  background:#e8f2ff;
  color:#1677ff;
}
.tag-writer{ background:#fff1e6; color:#fa8c16; }
.tag-translator{ background:#e6fffb; color:#13c2c2; }
.tag-summary{ background:#f0f5ff; color:#597ef7; }

.item-time{
  font-size:22rpx;
  color:#bbb;
}

.item-title{
  font-size:28rpx;
  font-weight:600;
  color:#333;
  margin-bottom:6rpx;
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis;
}

.item-preview{
  font-size:24rpx;
  color:#999;
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis;
}

.item-delete{
  flex-shrink:0;
  margin-left:20rpx;
  font-size:24rpx;
  color:#ff4d4f;
  padding:10rpx 16rpx;
}

.empty-state{
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  padding-top:200rpx;
}

.empty-icon{
  font-size:88rpx;
  margin-bottom:20rpx;
}

.empty-text{
  font-size:30rpx;
  font-weight:600;
  color:#333;
  margin-bottom:10rpx;
}

.empty-desc{
  font-size:24rpx;
  color:#999;
}
