.glass-tabbar{
  position:fixed;
  left:0;
  right:0;
  bottom:0;
  z-index:999;
  box-sizing:border-box;
  height:calc(132rpx + env(safe-area-inset-bottom));
  padding:20rpx 20rpx calc(8rpx + env(safe-area-inset-bottom));
  background:transparent;
}

.glass-surface{
  position:relative;
  display:flex;
  height:100%;
  overflow:hidden;
  border:1rpx solid rgba(255,255,255,.82);
  border-radius:48rpx;
  background:rgba(255,255,255,.8);
  backdrop-filter:blur(28rpx) saturate(165%);
  -webkit-backdrop-filter:blur(28rpx) saturate(165%);
  box-shadow:0 8rpx 28rpx rgba(35,63,111,.12), inset 0 1rpx 0 rgba(255,255,255,.9);
}

.active-pill{
  position:absolute;
  z-index:0;
  top:10rpx;
  bottom:10rpx;
  left:0;
  width:20%;
  border-radius:42rpx;
  background:linear-gradient(135deg,rgba(44,139,255,.25),rgba(117,188,255,.46));
  box-shadow:inset 0 1rpx 0 rgba(255,255,255,.72), 0 5rpx 15rpx rgba(22,119,255,.16);
  transition:transform 420ms cubic-bezier(.22,1,.36,1);
}

.tab-item{
  position:relative;
  z-index:1;
  display:flex;
  flex:1;
  align-items:center;
  justify-content:center;
  min-width:0;
}

.tab-icon{
  width:42rpx;
  height:42rpx;
  transition:transform 300ms cubic-bezier(.22,1,.36,1), opacity 220ms ease;
}

.tab-item:active .tab-icon{
  transform:scale(.86);
  opacity:.72;
}
