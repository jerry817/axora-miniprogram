.input-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
  width: 100%;
}

.input-wrap__input {
  flex: 1;
  min-width: 0;
  min-height: 72rpx;
  padding: 16rpx 24rpx;
  background: #f5f5f5;
  border-radius: 28rpx;
  font-size: 30rpx;
  line-height: 40rpx;
  box-sizing: border-box;
}

.input-wrap__button {
  width: 96rpx;
  height: 72rpx;
  padding: 0;
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  background: #1677ff;
  flex: 0 0 96rpx;
}

.input-wrap__send-icon {
  width: 34rpx;
  height: 34rpx;
}

.input-wrap__button::after {
  border: none;
}

.input-wrap__button--disabled {
  background: #a8c8fa;
  color: #fff;
}
